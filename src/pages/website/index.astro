---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
    title="Jasa Pembuatan Website di Karangasem | Bali Nusa Media"
    description="Jasa pembuatan website profesional untuk bisnis, UMKM, villa, dan perusahaan di Karangasem, Bali."
>

    <main class="hub-container service-page">

        <!-- HERO -->
        <section class="service-hero">

            <div class="service-hero-text">

                <p class="eyebrow">
                    WEB DEVELOPMENT
                </p>

                <h1>
                    Jasa Pembuatan Website
                    Profesional untuk Bisnis
                </h1>

                <p>
                    Bali Nusa Media membantu bisnis dan UMKM
                    membangun website yang cepat, responsif,
                    mudah digunakan, dan dirancang dengan
                    memperhatikan kebutuhan mesin pencari.
                </p>

                <a
                    href="https://wa.me/6285168981959"
                    class="btn-cta"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Konsultasi Website
                </a>

            </div>


            <div class="service-hero-image">

                <img
                    src="/assets/img/hero.webp"
                    alt="Jasa pembuatan website profesional Bali Nusa Media"
                >

            </div>

        </section>


        <!-- JENIS -->
        <section class="service-section">

            <div class="section-title">

                <p class="eyebrow">
                    JENIS WEBSITE
                </p>

                <h2>
                    Website untuk Berbagai Kebutuhan Bisnis
                </h2>

            </div>


            <div class="service-grid-3">

                <article class="service-info-card">

                    <h3>
                        Website Perusahaan
                    </h3>

                    <p>
                        Menampilkan profil perusahaan,
                        layanan, portofolio, dan informasi
                        kontak secara profesional.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Website UMKM
                    </h3>

                    <p>
                        Membantu usaha kecil dan menengah
                        memiliki kehadiran profesional
                        di Internet.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Website Villa & Hospitality
                    </h3>

                    <p>
                        Website untuk villa, penginapan,
                        restoran, dan bisnis hospitality.
                    </p>

                </article>

            </div>

        </section>


        <!-- FITUR -->
        <section class="service-section service-section-soft">

            <div class="section-title">

                <p class="eyebrow">
                    KONSEP WEBSITE
                </p>

                <h2>
                    Website Dibangun Sesuai Tujuan Bisnis
                </h2>

            </div>


            <div class="service-grid-2">

                <article class="service-info-card">

                    <h3>
                        Responsif
                    </h3>

                    <p>
                        Tampilan disiapkan agar nyaman digunakan
                        pada desktop, tablet, maupun smartphone.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Struktur SEO
                    </h3>

                    <p>
                        Struktur halaman, judul, deskripsi,
                        dan konten disiapkan agar lebih mudah
                        dipahami mesin pencari.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Kecepatan
                    </h3>

                    <p>
                        Website dirancang dengan memperhatikan
                        performa dan efisiensi aset.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Identitas Bisnis
                    </h3>

                    <p>
                        Desain disesuaikan dengan identitas,
                        layanan, dan karakter bisnis Anda.
                    </p>

                </article>

            </div>

        </section>


        <!-- PORTFOLIO -->
        <section class="service-section">

            <div class="section-title">

                <p class="eyebrow">
                    PORTFOLIO
                </p>

                <h2>
                    Contoh Website yang Pernah Kami Kerjakan
                </h2>

            </div>


            <div class="portfolio-grid">

                <article class="portfolio-card">
                    <img
                        src="/assets/img/web-dev/danacepatbpkb.png"
                        alt="Portfolio website Bali Nusa Media"
                        loading="lazy"
                    >
                </article>

                <article class="portfolio-card">
                    <img
                        src="/assets/img/web-dev/danajayamotor.png"
                        alt="Portfolio website Bali Nusa Media"
                        loading="lazy"
                    >
                </article>

                <article class="portfolio-card">
                    <img
                        src="/assets/img/web-dev/explorebalitour.png"
                        alt="Portfolio website Bali Nusa Media"
                        loading="lazy"
                    >
                </article>

                <article class="portfolio-card">
                    <img
                        src="/assets/img/web-dev/padiandspice.png"
                        alt="Portfolio website Bali Nusa Media"
                        loading="lazy"
                    >
                </article>

            </div>

        </section>


        <!-- PROSES -->
        <section class="service-section">

            <div class="section-title">

                <p class="eyebrow">
                    PROSES PEMBUATAN
                </p>

                <h2>
                    Dari Konsep Sampai Website Online
                </h2>

            </div>


            <div class="service-process">

                <div>
                    <span>01</span>
                    <h3>Diskusi</h3>
                    <p>
                        Membahas kebutuhan dan tujuan website.
                    </p>
                </div>

                <div>
                    <span>02</span>
                    <h3>Desain</h3>
                    <p>
                        Menentukan struktur dan tampilan.
                    </p>
                </div>

                <div>
                    <span>03</span>
                    <h3>Development</h3>
                    <p>
                        Membangun dan menguji website.
                    </p>
                </div>

                <div>
                    <span>04</span>
                    <h3>Publikasi</h3>
                    <p>
                        Website siap digunakan dan dikembangkan.
                    </p>
                </div>

            </div>

        </section>


        <!-- CTA -->
        <section class="cta-section">

            <h2>
                Ingin Membuat Website untuk Bisnis Anda?
            </h2>

            <p>
                Konsultasikan kebutuhan website Anda
                dengan Bali Nusa Media.
            </p>

            <a
                href="https://wa.me/6285168981959"
                class="btn-cta"
                target="_blank"
                rel="noopener noreferrer"
            >
                Konsultasi via WhatsApp
            </a>

        </section>

    </main>

</MainLayout>
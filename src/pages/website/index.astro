---
import MainLayout from "../../layouts/MainLayout.astro";
import allProducts from "../../data/products.json";

// Filter khusus produk berkategori Website
const webProducts = allProducts.filter(item => item.kategori === "Website");
---

<MainLayout
    title="Jasa Pembuatan Website di Karangasem | Bali Nusa Media"
    description="Jasa pembuatan website profesional untuk bisnis, UMKM, villa, dan perusahaan di Karangasem, Bali."
>

    <main class="hub-container service-page">

        <!-- HERO -->
        <section class="service-hero">

            <div class="service-hero-text">

                <p class="eyebrow">
                    WEB DEVELOPMENT
                </p>

                <h1>
                    Jasa Pembuatan Website
                    Profesional untuk Bisnis
                </h1>

                <p>
                    Bali Nusa Media membantu bisnis dan UMKM
                    membangun website yang cepat, responsif,
                    mudah digunakan, dan dirancang dengan
                    memperhatikan kebutuhan mesin pencari.
                </p>

                <a
                    href="https://wa.me/6285168981959"
                    class="btn-cta"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Konsultasi Website
                </a>

            </div>


            <div class="service-hero-image">

                <img
                    src="/assets/img/hero.webp"
                    alt="Jasa pembuatan website profesional Bali Nusa Media"
                >

            </div>

        </section>


        <!-- JENIS -->
        <section class="service-section">

            <div class="section-title">

                <p class="eyebrow">
                    JENIS WEBSITE
                </p>

                <h2>
                    Website untuk Berbagai Kebutuhan Bisnis
                </h2>

            </div>


            <div class="service-grid-3">

                <article class="service-info-card">

                    <h3>
                        Website Perusahaan
                    </h3>

                    <p>
                        Menampilkan profil perusahaan,
                        layanan, portofolio, dan informasi
                        kontak secara profesional.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Website UMKM
                    </h3>

                    <p>
                        Mempromosikan usaha kecil dan menengah
                        agar memiliki kehadiran online
                        yang profesional.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Website Villa & Hospitality
                    </h3>

                    <p>
                        Website untuk villa, penginapan,
                        restoran, dan bisnis hospitality.
                    </p>

                </article>

            </div>

        </section>


        <!-- FITUR -->
        <section class="service-section service-section-soft">

            <div class="section-title">

                <p class="eyebrow">
                    KONSEP WEBSITE
                </p>

                <h2>
                    Website Dibangun Sesuai Tujuan Bisnis
                </h2>

            </div>


            <div class="service-grid-2">

                <article class="service-info-card">

                    <h3>
                        Responsif
                    </h3>

                    <p>
                        Tampilan disiapkan agar nyaman digunakan
                        pada desktop, tablet, maupun smartphone.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Struktur SEO
                    </h3>

                    <p>
                        Struktur halaman, judul, deskripsi,
                        dan konten disiapkan agar lebih mudah
                        dipahami mesin pencari.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Kecepatan
                    </h3>

                    <p>
                        Website dirancang dengan memperhatikan
                        performa dan efisiensi aset.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Identitas Bisnis
                    </h3>

                    <p>
                        Desain disesuaikan dengan identitas,
                        layanan, dan karakter bisnis Anda.
                    </p>

                </article>

            </div>

        </section>


        <!-- KATALOG PAKET WEBSITE (DITAMPILKAN OTOMATIS DARI PRODUCTS.JSON) -->
        <section class="service-section">

            <div class="section-title">
                <p class="eyebrow">
                    DAFTAR PAKET
                </p>
                <h2>
                    Pilihan Paket Website Terbaik
                </h2>
                <p>
                    Pilih paket pengembangan website yang sesuai dengan skala dan kebutuhan bisnis Anda.
                </p>
            </div>

            <div class="custom-product-grid">
                {webProducts.map((item) => (
                    <div class="custom-product-card">
                        <div>
                            <div class="custom-product-img-wrap">
                                <img src={item.gambar} alt={item.nama_paket} loading="lazy" />
                            </div>
                            <span class="custom-badge">{item.kategori}</span>
                            <h3 class="custom-product-title">{item.nama_paket}</h3>
                            <p class="custom-product-desc">{item.deskripsi}</p>
                            <p class="custom-product-spec">Spesifikasi: {item.spesifikasi}</p>
                        </div>

                        <div class="custom-product-footer">
                            <div class="custom-price-wrap">
                                <span class="custom-price">{item.harga}</span>
                                {item.harga_coret && <span class="custom-price-old">{item.harga_coret}</span>}
                            </div>
                            
                            <a 
                                href={`https://wa.me/${item.whatsapp}?text=Halo,%20saya%20tertarik%20dengan%20${encodeURIComponent(item.nama_paket)}`} 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="custom-btn-whatsapp"
                            >
                                Pesan via WhatsApp
                            </a>
                        </div>
                    </div>
                ))}
            </div>

        </section>


        <!-- PORTFOLIO -->
        <section class="service-section service-section-soft">

            <div class="section-title">

                <p class="eyebrow">
                    PORTFOLIO
                </p>

                <h2>
                    Contoh Website yang Pernah Kami Kerjakan
                </h2>

            </div>


            <div class="portfolio-grid">

                <article class="portfolio-card">
                    <img
                        src="/assets/img/web-dev/danacepatbpkb.png"
                        alt="Portfolio website Bali Nusa Media"
                        loading="lazy"
                    >
                </article>

                <article class="portfolio-card">
                    <img
                        src="/assets/img/web-dev/danajayamotor.png"
                        alt="Portfolio website Bali Nusa Media"
                        loading="lazy"
                    >
                </article>

                <article class="portfolio-card">
                    <img
                        src="/assets/img/web-dev/explorebalitour.png"
                        alt="Portfolio website Bali Nusa Media"
                        loading="lazy"
                    >
                </article>

                <article class="portfolio-card">
                    <img
                        src="/assets/img/web-dev/padiandspice.png"
                        alt="Portfolio website Bali Nusa Media"
                        loading="lazy"
                    >
                </article>

            </div>

        </section>


        <!-- PROSES -->
        <section class="service-section">

            <div class="section-title">

                <p class="eyebrow">
                    PROSES PEMBUATAN
                </p>

                <h2>
                    Dari Konsep Sampai Website Online
                </h2>

            </div>


            <div class="service-process">

                <div>
                    <span>01</span>
                    <h3>Diskusi</h3>
                    <p>
                        Membahas kebutuhan dan tujuan website.
                    </p>
                </div>

                <div>
                    <span>02</span>
                    <h3>Desain</h3>
                    <p>
                        Menentukan struktur dan tampilan.
                    </p>
                </div>

                <div>
                    <span>03</span>
                    <h3>Development</h3>
                    <p>
                        Membangun dan menguji website.
                    </p>
                </div>

                <div>
                    <span>04</span>
                    <h3>Publikasi</h3>
                    <p>
                        Website siap digunakan dan dikembangkan.
                    </p>
                </div>

            </div>

        </section>


        <!-- CTA -->
        <section class="cta-section">

            <h2>
                Ingin Membuat Website untuk Bisnis Anda?
            </h2>

            <p>
                Konsultasikan kebutuhan website Anda
                dengan Bali Nusa Media.
            </p>

            <a
                href="https://wa.me/6285168981959"
                class="btn-cta"
                target="_blank"
                rel="noopener noreferrer"
            >
                Konsultasi via WhatsApp
            </a>

        </section>

    </main>

</MainLayout>

<!-- CSS KARTU PRODUK (MENGGUNAKAN DESIGN SYSTEM GLOBAL) -->
<style>
  .custom-product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 28px;
    margin-top: 2rem;
  }

  .custom-product-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .custom-product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .custom-product-img-wrap {
    background: var(--sand);
    height: 190px;
    border-radius: calc(var(--radius) - 4px);
    overflow: hidden;
    margin-bottom: 16px;
  }

  .custom-product-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--sand);
    color: var(--blue);
    padding: 4px 10px;
    border-radius: 20px;
    margin-bottom: 10px;
  }

  .custom-product-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .custom-product-desc {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-bottom: 10px;
    line-height: 1.5;
  }

  .custom-product-spec {
    font-size: 0.82rem;
    color: #6b7280;
    font-style: italic;
    margin-bottom: 20px;
  }

  .custom-product-footer {
    border-top: 1px solid var(--line);
    padding-top: 16px;
    margin-top: auto;
  }

  .custom-price-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .custom-price {
    font-size: 1.25rem;
    font-weight: 800;
    color: #dc2626;
  }

  .custom-price-old {
    font-size: 0.85rem;
    color: #9ca3af;
    text-decoration: line-through;
  }

  .custom-btn-whatsapp {
    display: block;
    width: 100%;
    background-color: #16a34a;
    color: #ffffff;
    text-align: center;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .custom-btn-whatsapp:hover {
    background-color: #15803d;
  }
</style>
---
import MainLayout from "../../layouts/MainLayout.astro";
import allProducts from "../../data/products.json";

// Filter khusus produk berkategori Website
const webProducts = allProducts.filter(item => item.kategori === "Website");

// Data Testimoni Khusus Web Development
const testimonials = [
  {
    nama: "Gede Pasek",
    usaha: "Pengelola Villa & Tour",
    lokasi: "Candidasa, Karangasem",
    isi: "Website villa kami loading-nya sangat cepat di HP tamu asing. Booking langsung lewat tombol WhatsApp meningkat pesat sejak dibuatkan web baru oleh Bali Nusa Media.",
    bintang: 5
  },
  {
    nama: "Ni Luh Putu Anggreni",
    usaha: "Owner Usaha Kuliner & Oleh-oleh",
    lokasi: "Amlapura, Karangasem",
    isi: "Tampilan website rapi dan profesional. Yang paling saya suka, tokonya gampang dicari di Google saat orang mengetik kuliner khas Karangasem.",
    bintang: 5
  },
  {
    nama: "Komang Arya",
    usaha: "Direktur Perusahaan Rental & Logistik",
    lokasi: "Denpasar, Bali",
    isi: "Desain clean, navigasi jelas, dan performa Google PageSpeed-nya tembus skor hijau. Komunikasi saat revisi sangat responsif dan solutif.",
    bintang: 5
  }
];

// Data FAQ Khusus Web Development
const faqList = [
  {
    q: "Berapa lama proses pembuatan website sampai online?",
    a: "Untuk paket Landing Page atau Website UMKM standar, pengerjaan berkisar antara 3 sampai 7 hari kerja setelah materi (teks dan foto) terkumpul. Untuk website kustom perusahaan atau sistem reservasi villa butuh waktu 10 hingga 20 hari kerja."
  },
  {
    q: "Apakah website sudah termasuk domain dan hosting?",
    a: "Ya, seluruh paket website kami sudah include sewa domain (.com / .id / .my.id) serta konfigurasi cloud hosting berkecepatan tinggi dengan proteksi SSL gratis (HTTPS aman)."
  },
  {
    q: "Apakah saya bisa melayani pesanan dari luar Karangasem?",
    a: "Sangat bisa. Kami berbasis di Karangasem (Amlapura) namun melayani klien di seluruh Bali (Denpasar, Badung, Gianyar, Ubud) hingga tingkat nasional secara online melalui komunikasi WhatsApp dan Google Meet."
  },
  {
    q: "Apakah website sudah mobile friendly dan terindeks Google?",
    a: "Semua website yang kami kembangkan dirancang dengan prinsip mobile-first (sangat ringan dibuka di HP) dan telah dioptimasi dengan struktur SEO On-Page dasar agar mudah ditemukan mesin pencari Google."
  },
  {
    q: "Bagaimana jika saya tidak bisa mengelola atau mengupdate website?",
    a: "Kami menyediakan panduan penggunaan dan layanan maintenance berkala. Anda juga dapat berkonsultasi kapan saja jika ingin memperbarui konten atau menambah promo produk."
  }
];

// Schema Markup JSON-LD (LocalBusiness + FAQPage)
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "name": "Bali Nusa Media - Jasa Pembuatan Website & Digital Marketing",
      "image": "https://balinusamedia.com/assets/img/hero.webp",
      "telephone": "+6285168981959",
      "priceRange": "Rp 500.000 - Rp 5.000.000",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Karangasem",
        "addressRegion": "Bali",
        "addressCountry": "ID"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -8.4485,
        "longitude": 115.6128
      },
      "url": "https://balinusamedia.com/layanan/jasa-pembuatan-website",
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "Karangasem" },
        { "@type": "AdministrativeArea", "name": "Amlapura" },
        { "@type": "AdministrativeArea", "name": "Amed" },
        { "@type": "AdministrativeArea", "name": "Candidasa" },
        { "@type": "AdministrativeArea", "name": "Denpasar" },
        { "@type": "AdministrativeArea", "name": "Badung" },
        { "@type": "AdministrativeArea", "name": "Gianyar" },
        { "@type": "AdministrativeArea", "name": "Bali" }
      ],
      "description": "Jasa pembuatan website profesional, cepat, responsif, dan ramah SEO untuk UMKM, villa, restoran, tour travel, dan perusahaan di Karangasem dan seluruh Bali."
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqList.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<MainLayout
  title="Jasa Pembuatan Website Karangasem & Seluruh Bali | Web Desain Cepat & SEO Friendly"
  description="Jasa pembuatan website profesional di Karangasem & seluruh Bali. Solusi website cepat, mobile-friendly, dan ramah SEO untuk villa, UMKM, restoran, dan profil bisnis."
>

  <!-- Panggil Stylesheet Bersama -->
  <link rel="stylesheet" href="/assets/css/style.css" />

  <!-- Schema Markup JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <main class="hub-container service-page">

    <!-- 1. HERO SECTION -->
    <section class="service-hero">
      <div class="service-hero-text">
        <p class="eyebrow">WEB DEVELOPMENT &amp; DIGITAL AGENCY</p>
        <h1>
          Jasa Pembuatan Website di Karangasem &amp; Layanan Digital Seluruh Bali
        </h1>
        <p>
          <strong>Bali Nusa Media</strong> membantu bisnis lokal, UMKM, villa, restoran, dan instansi memiliki website berkecepatan tinggi, tampilan modern, ramah pengguna, dan siap bersaing di halaman Google.
        </p>
        <div class="hero-cta-group">
          <a
            href="https://wa.me/6285168981959?text=Halo%20Bali%20Nusa%20Media,%20saya%20mau%20konsultasi%20pembuatan%20website"
            class="btn-cta"
            target="_blank"
            rel="noopener noreferrer"
          >
            Konsultasi Website Gratis
          </a>
        </div>
      </div>

      <div class="service-hero-image">
        <img
          src="/assets/img/hero.webp"
          alt="Jasa pembuatan website profesional Karangasem Bali - Bali Nusa Media"
          width="600"
          height="400"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </section>

    <!-- 2. SECTION MASALAH / TANTANGAN BISNIS ONLINE -->
    <section class="service-section">
      <div class="section-title">
        <p class="eyebrow">SOLUSI DIGITAL BISNIS</p>
        <h2>Website Bukan Sekadar Brosur Online</h2>
        <p>
          Website yang lambat, tidak ramah ponsel, atau sulit ditemukan di Google hanya akan membuang peluang transaksi. Kami merancang website yang benar-benar menghasilkan.
        </p>
      </div>

      <div class="service-grid-3">
        <article class="service-info-card">
          <h3>Tampilan Kurang Meyakinkan</h3>
          <p>
            Desain kuno membuat calon pelanggan meragukan kredibilitas usaha Anda. Kami buatkan desain visual berkelas yang mencerminkan karakter kuat brand Anda.
          </p>
        </article>

        <article class="service-info-card">
          <h3>Sulit Ditemukan di Google</h3>
          <p>
            Tanpa struktur On-Page SEO yang tepat, calon pembeli akan lari ke kompetitor. Struktur kode kami ramah algoritma mesin pencari sejak hari pertama online.
          </p>
        </article>

        <article class="service-info-card">
          <h3>Loading Lemot Bikin Tamu Kabur</h3>
          <p>
            Pengguna internet meninggalkan website yang loading lebih dari 3 detik. Kami mengoptimasi aset gambar dan arsitektur web agar terbuka instan di semua ponsel.
          </p>
        </article>
      </div>
    </section>

    <!-- 3. SECTION STANDAR KUALITAS & FITUR -->
    <section class="service-section service-section-soft">
      <div class="section-title">
        <p class="eyebrow">KEUNGGULAN KAMI</p>
        <h2>Standar Website Modern untuk Konversi Maksimal</h2>
        <p>Setiap baris kode dan komponen visual dirancang dengan tujuan bisnis yang jelas.</p>
      </div>

      <div class="service-grid-2">
        <article class="service-info-card">
          <h3>Mobile First &amp; Responsif</h3>
          <p>Website tampil sempurna dan nyaman dinavigasi di layar HP, tablet, maupun layar monitor komputer.</p>
        </article>

        <article class="service-info-card">
          <h3>Optimalisasi SEO Lokal</h3>
          <p>Memaksimalkan kata kunci area target (Karangasem, Amed, Denpasar, Ubud) agar bisnis cepat terdeteksi pasar Bali.</p>
        </article>

        <article class="service-info-card">
          <h3>Performa Kecepatan Tinggi</h3>
          <p>Dibangun dengan teknologi terkini tanpa bloatware, menjamin skor performa prima di Google PageSpeed Insights.</p>
        </article>

        <article class="service-info-card">
          <h3>Integrasi WhatsApp &amp; Sosmed Langsung</h3>
          <p>Pengunjung dapat langsung menghubungi kontak atau reservasi melalui tombol WhatsApp otomatis.</p>
        </article>
      </div>
    </section>

    <!-- 4. SECTION KATALOG PAKET PRODUK -->
    <section class="service-section">
      <div class="section-title">
        <p class="eyebrow">PILIHAN PAKET</p>
        <h2>Paket Pembuatan Website Siap Pakai</h2>
        <p>Solusi paket pengembangan website yang dapat disesuaikan dengan skala dan anggaran bisnis Anda.</p>
      </div>

      <div class="custom-product-grid">
        {webProducts.map((item) => (
          <div class="custom-product-card">
            <div>
              <div class="custom-product-img-wrap">
                <img
                  src={item.gambar}
                  alt={`${item.nama_paket} - Bali Nusa Media`}
                  loading="lazy"
                  width="400"
                  height="250"
                />
              </div>
              <span class="custom-badge">{item.kategori}</span>
              <h3 class="custom-product-title">{item.nama_paket}</h3>
              <p class="custom-product-desc">{item.deskripsi}</p>
              <p class="custom-product-spec"><strong>Spesifikasi:</strong> {item.spesifikasi}</p>
              {item.unggulan && (
                <p class="custom-product-feature"><strong>Keunggulan:</strong> {item.unggulan}</p>
              )}
            </div>

            <div class="custom-product-footer">
              <div class="custom-price-wrap">
                <span class="custom-price">{item.harga}</span>
                {item.harga_coret && <span class="custom-price-old">{item.harga_coret}</span>}
              </div>

              <a
                href={`https://wa.me/${item.whatsapp}?text=Halo%20Bali%20Nusa%20Media,%20saya%20tertarik%20dengan%20${encodeURIComponent(item.nama_paket)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="custom-btn-whatsapp"
              >
                Pesan via WhatsApp
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. SECTION PORTOFOLIO -->
    <section class="service-section service-section-soft">
      <div class="section-title">
        <p class="eyebrow">STUDI KASUS</p>
        <h2>Portofolio Proyek yang Pernah Kami Kerjakan</h2>
        <p>Beberapa brand dan usaha yang telah mempercayakan transformasi digitalnya kepada Bali Nusa Media.</p>
      </div>

      <div class="portfolio-grid">
        <article class="portfolio-card">
          <img
            src="/assets/img/web-dev/danacepatbpkb.png"
            alt="Proyek Website Layanan Dana Cepat BPKB"
            loading="lazy"
            width="500"
            height="320"
          />
        </article>

        <article class="portfolio-card">
          <img
            src="/assets/img/web-dev/danajayamotor.png"
            alt="Proyek Website Dana Jaya Motor"
            loading="lazy"
            width="500"
            height="320"
          />
        </article>

        <article class="portfolio-card">
          <img
            src="/assets/img/web-dev/explorebalitour.png"
            alt="Proyek Website Explore Bali Tour & Travel"
            loading="lazy"
            width="500"
            height="320"
          />
        </article>

        <article class="portfolio-card">
          <img
            src="/assets/img/web-dev/padiandspice.png"
            alt="Proyek Website Kuliner dan Hospitality Padi and Spice"
            loading="lazy"
            width="500"
            height="320"
          />
        </article>
      </div>
    </section>

    <!-- 6. PROSES KERJA -->
    <section class="service-section">
      <div class="section-title">
        <p class="eyebrow">TAHAPAN PENGERJAAN</p>
        <h2>Dari Konsep Sampai Website Siap Menerima Order</h2>
      </div>

      <div class="service-process">
        <div>
          <span>01</span>
          <h3>Konsultasi &amp; Materi</h3>
          <p>Mendiskusikan profil bisnis, struktur menu, tujuan pemasaran, serta pengumpulan foto dan teks pendukung.</p>
        </div>
        <div>
          <span>02</span>
          <h3>Perancangan &amp; UI/UX</h3>
          <p>Menyusun mockup tata letak halaman yang nyaman dibaca pengunjung di smartphone dan laptop.</p>
        </div>
        <div>
          <span>03</span>
          <h3>Development &amp; SEO</h3>
          <p>Pengkodean sistem, optimasi kompresi aset gambar, setup SSL HTTPS, dan pemasangan meta tag SEO.</p>
        </div>
        <div>
          <span>04</span>
          <h3>Review &amp; Serah Terima</h3>
          <p>Pemeriksaan menyeluruh bersama klien, pelatihan update konten mandiri, hingga website live di domain utama.</p>
        </div>
      </div>
    </section>

    <!-- 7. WILAYAH OPERASIONAL (LOCAL SEO TARGETING) -->
    <section class="service-section coverage-section">
      <div class="section-title">
        <p class="eyebrow">WILAYAH LAYANAN</p>
        <h2>Melayani Klien di Karangasem &amp; Seluruh Pulau Bali</h2>
        <p>
          Dukungan pembuatan website tatap muka untuk wilayah Karangasem, serta konsultasi virtual intensif untuk seluruh Bali dan kota besar di Indonesia.
        </p>
      </div>

      <div class="coverage-grid">
        <div class="coverage-card">
          <h3>Area Utama (Karangasem &amp; Sekitarnya):</h3>
          <p>
            Amlapura, Candidasa, Amed, Tulamben, Padangbai, Manggis, Abang, Bebandem, Rendang, Selat, Kubu, dan Sidemen.
          </p>
        </div>
        <div class="coverage-card">
          <h3>Jangkauan Seluruh Bali:</h3>
          <p>
            Denpasar, Badung (Kuta, Canggu, Seminyak), Gianyar (Ubud), Klungkung, Tabanan, Bangli, Buleleng (Singaraja), dan Jembrana.
          </p>
        </div>
      </div>
    </section>

    <!-- 8. TESTIMONI KLIEN -->
    <section class="service-section">
      <div class="section-title">
        <p class="eyebrow">TESTIMONI KLIEN</p>
        <h2>Apa Kata Pemilik Usaha Tentang Kami?</h2>
        <p>Kepuasan pelaku usaha, villa, dan perusahaan yang telah go-digital bersama kami.</p>
      </div>

      <div class="testimonial-grid">
        {testimonials.map((testi) => (
          <article class="testimonial-card">
            <div class="testimonial-stars">{"★".repeat(testi.bintang)}</div>
            <p class="testimonial-text">"{testi.isi}"</p>
            <div class="testimonial-author">
              <strong>{testi.nama}</strong>
              <span>{testi.usaha} — {testi.lokasi}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 9. FAQ (SEBELUM FINAL CTA) -->
    <section class="service-section">
      <div class="section-title">
        <p class="eyebrow">TANYA JAWAB</p>
        <h2>Pertanyaan yang Sering Diajukan (FAQ)</h2>
        <p>Informasi penting seputar biaya, proses kerja, dan garansi layanan pembuatan website.</p>
      </div>

      <div class="faq-container">
        {faqList.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">
              <span>{faq.q}</span>
              <span class="faq-icon">+</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- 10. FINAL CTA FOOTER -->
    <section class="cta-section">
      <h2>Siap Meningkatkan Penjualan dengan Website Profesional?</h2>
      <p>
        Diskusikan konsep website impian Anda bersama tim pengembang <strong>Bali Nusa Media</strong>. Dapatkan penawaran harga terbaik dan konsultasi gratis sekarang.
      </p>
      <a
        href="https://wa.me/6285168981959?text=Halo%20Bali%20Nusa%20Media,%20saya%20mau%20buat%20website%20untuk%20bisnis%20saya"
        class="btn-cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        Konsultasi via WhatsApp
      </a>
    </section>

  </main>
</MainLayout>
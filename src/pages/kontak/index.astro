---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
    title="Kontak Bali Nusa Media | Internet, CCTV & Website Karangasem"
    description="Hubungi Bali Nusa Media untuk kebutuhan Internet & WiFi, CCTV, dan Website di Karangasem, Bali."
>

    <main class="hub-container service-page">

        <!-- =====================================================
             HERO KONTAK
        ====================================================== -->

        <section class="service-hero">

            <div class="service-hero-text">

                <p class="eyebrow">
                    HUBUNGI KAMI
                </p>

                <h1>
                    Mari Diskusikan
                    Kebutuhan Teknologi Anda
                </h1>

                <p>
                    Ceritakan kebutuhan Internet & WiFi,
                    CCTV, atau Website Anda kepada
                    Bali Nusa Media. Kami siap membantu
                    mencari solusi yang sesuai.
                </p>

                <a
                    href="https://wa.me/6285168981959"
                    class="btn-cta"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Konsultasi via WhatsApp
                </a>

            </div>


            <div class="service-hero-image">

                <img
                    src="/assets/img/hero.webp"
                    alt="Hubungi Bali Nusa Media Karangasem"
                >

            </div>

        </section>


        <!-- =====================================================
             INFORMASI KONTAK
        ====================================================== -->

        <section class="service-section">

            <div class="section-title">

                <p class="eyebrow">
                    INFORMASI KONTAK
                </p>

                <h2>
                    Bali Nusa Media
                </h2>

            </div>


            <div class="service-grid-2">


                <!-- WHATSAPP -->

                <article class="service-info-card">

                    <h3>
                        WhatsApp
                    </h3>

                    <p>
                        Hubungi kami melalui WhatsApp untuk
                        konsultasi kebutuhan teknologi,
                        permintaan informasi, atau diskusi
                        pekerjaan.
                    </p>

                    <a
                        href="https://wa.me/6285168981959"
                        class="btn-card"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        +62 851-6898-1959
                    </a>

                </article>


                <!-- EMAIL -->

                <article class="service-info-card">

                    <h3>
                        Email
                    </h3>

                    <p>
                        Untuk pertanyaan atau kebutuhan
                        komunikasi melalui email, Anda
                        dapat menghubungi alamat berikut.
                    </p>

                    <a
                        href="mailto:balinusamedia@gmail.com"
                        class="btn-card"
                    >
                        balinusamedia@gmail.com
                    </a>

                </article>


                <!-- ALAMAT -->

                <article class="service-info-card">

                    <h3>
                        Alamat
                    </h3>

                    <p>
                        Perum Grand Park Bolok C No. 8,
                        Subagan, Kecamatan Karangasem,
                        Kabupaten Karangasem, Bali.
                    </p>

                </article>


                <!-- WEBSITE -->

                <article class="service-info-card">

                    <h3>
                        Website
                    </h3>

                    <p>
                        Informasi mengenai layanan,
                        portofolio, dan artikel Bali Nusa
                        Media tersedia di website resmi kami.
                    </p>

                    <a
                        href="/"
                        class="btn-card"
                    >
                        balinusamedia.com
                    </a>

                </article>

            </div>

        </section>


        <!-- =====================================================
             LAYANAN
        ====================================================== -->

        <section class="service-section service-section-soft">

            <div class="section-title">

                <p class="eyebrow">
                    LAYANAN KAMI
                </p>

                <h2>
                    Kebutuhan Apa yang Ingin Anda Konsultasikan?
                </h2>

            </div>


            <div class="service-grid-3">

                <article class="service-info-card">

                    <h3>
                        Internet & WiFi
                    </h3>

                    <p>
                        Konsultasi pemasangan WiFi,
                        jaringan rumah, kantor, villa,
                        toko, restoran, dan bisnis.
                    </p>

                    <a
                        href="/internet/"
                        class="btn-card"
                    >
                        Lihat Internet & WiFi
                    </a>

                </article>


                <article class="service-info-card">

                    <h3>
                        CCTV
                    </h3>

                    <p>
                        Konsultasi kebutuhan kamera,
                        pemasangan CCTV, monitoring,
                        dan sistem keamanan.
                    </p>

                    <a
                        href="/cctv/"
                        class="btn-card"
                    >
                        Lihat CCTV
                    </a>

                </article>


                <article class="service-info-card">

                    <h3>
                        Website
                    </h3>

                    <p>
                        Konsultasi pembuatan website
                        perusahaan, UMKM, villa,
                        dan bisnis.
                    </p>

                    <a
                        href="/website/"
                        class="btn-card"
                    >
                        Lihat Website
                    </a>

                </article>

            </div>

        </section>


        <!-- =====================================================
             AREA LAYANAN
        ====================================================== -->

        <section class="service-section">

            <div class="section-title">

                <p class="eyebrow">
                    AREA LAYANAN
                </p>

                <h2>
                    Karangasem dan Sekitarnya
                </h2>

                <p>
                    Hubungi kami untuk mengetahui ketersediaan
                    layanan sesuai lokasi dan kebutuhan Anda.
                </p>

            </div>


            <div class="service-grid-3">

                <article class="service-info-card">
                    <h3>Karangasem</h3>
                    <p>
                        Area utama layanan Bali Nusa Media.
                    </p>
                </article>

                <article class="service-info-card">
                    <h3>Amlapura</h3>
                    <p>
                        Internet, CCTV, dan Website.
                    </p>
                </article>

                <article class="service-info-card">
                    <h3>Wilayah Sekitarnya</h3>
                    <p>
                        Konsultasikan kebutuhan dan lokasi
                        Anda kepada kami.
                    </p>
                </article>

            </div>

        </section>


        <!-- =====================================================
             CTA
        ====================================================== -->

        <section class="cta-section">

            <h2>
                Siap Membahas Kebutuhan Anda?
            </h2>

            <p>
                Hubungi Bali Nusa Media melalui WhatsApp
                dan ceritakan kebutuhan teknologi Anda.
            </p>

            <a
                href="https://wa.me/6285168981959"
                class="btn-cta"
                target="_blank"
                rel="noopener noreferrer"
            >
                Hubungi via WhatsApp
            </a>

        </section>

    </main>

</MainLayout>
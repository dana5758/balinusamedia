---
// src/pages/blog/index.astro (balinusamedia.com)
import MainLayout from "../../layouts/MainLayout.astro";

const defaultImage = "/assets/img/hero.webp";

// 5 Artikel Riil di Folder Project
const blogPosts = [
  {
    title: "Google Ads vs Instagram Ads: Mana yang Lebih Efektif Menghasilkan Penjualan di Bali?",
    slug: "google-ads-vs-instagram-ads-efektivitas",
    category: "Iklan Digital",
    filterKey: "ads",
    excerpt: "Analisis perbandingan komprehensif antara Google Search Ads dan Meta Ads Instagram/Facebook. Ketahui strategi terbaik sesuai tipe bisnis, target wisatawan, atau pasar lokal Bali.",
    publishDate: "26 September 2026",
    readTime: "6 menit baca",
    image: "/assets/img/hero.webp"
  },
  {
    title: "Berapa Biaya Pembuatan Website Company Profile & Toko Online di Bali?",
    slug: "berapa-biaya-pembuatan-website-company-profile-toko-online-di-bali",
    category: "Website",
    filterKey: "website",
    excerpt: "Rincian estimasi biaya riil pembuatan website profesional di Bali: biaya domain, cloud hosting cepat, kustom desain, pemeliharaan, serta hal penting agar terhindar dari biaya tersembunyi.",
    publishDate: "20 September 2026",
    readTime: "5 menit baca",
    image: "/assets/img/hero.webp"
  },
  {
    title: "Kenapa Kecepatan Loading Website Sangat Penting untuk Promosi Pariwisata Bali?",
    slug: "kenapa-kecepatan-loading-website-sangat-penting-untuk-promosi-pariwisata-bali",
    category: "Website",
    filterKey: "website",
    excerpt: "Sebanyak 53% calon tamu asing langsung menutup halaman jika loading melebihi 3 detik. Pahami dampak kecepatan akses terhadap Google PageSpeed dan konversi direct booking villa.",
    publishDate: "14 September 2026",
    readTime: "5 menit baca",
    image: "/assets/img/hero.webp"
  },
  {
    title: "Strategi SEO Lokal Bali: Panduan Lengkap Tembus Halaman 1 Google",
    slug: "strategi-seo-lokal-bali-halaman-1-google",
    category: "SEO Lokal",
    filterKey: "seo-lokal",
    excerpt: "Langkah teruji mengoptimalkan On-Page SEO, schema markup LocalBusiness JSON-LD, dan Google Business Profile agar usaha Anda mudah ditemukan di Denpasar, Badung, Gianyar, hingga Karangasem.",
    publishDate: "08 September 2026",
    readTime: "7 menit baca",
    image: "/assets/img/hero.webp"
  },
  {
    title: "Jasa Pembuatan Website Karangasem: Solusi UMKM & Bisnis Go-Digital",
    slug: "jasa-pembuatan-website-karangasem-solusi-umkm-bisnis-go-digital",
    category: "Website",
    filterKey: "website",
    excerpt: "Mendorong transformasi digital pengusaha kuliner, tour, kerajinan perak, dan homestay di Amlapura, Candidasa, Amed, dan Sidemen agar mampu menjangkau pasar nasional dan mancanegara.",
    publishDate: "01 September 2026",
    readTime: "5 menit baca",
    image: "/assets/img/hero.webp"
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Blog & Panduan Digital Marketing Bali - Bali Nusa Media",
  "description": "Kumpulan artikel edukatif seputar pembuatan website kencang, strategi iklan Google Search Ads, Meta Ads Instagram & FB, dan On-Page SEO lokal Bali.",
  "url": "https://balinusamedia.com/blog/",
  "publisher": {
    "@type": "Organization",
    "name": "PT. Bali Nusa Media",
    "logo": {
      "@type": "ImageObject",
      "url": "https://balinusamedia.com/assets/img/logo.webp"
    }
  }
};
---

<MainLayout
  title="Blog & Edukasi Bisnis Digital Bali | Website, SEO & Ads | Bali Nusa Media"
  description="Kumpulan panduan praktis dan tips digital marketing: cara membuat website kencang, optimasi SEO lokal Google, serta strategi iklan Google Ads & Meta Ads di Bali."
>

  <!-- Schema Markup JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <main class="blog-index-container">

    <!-- 1. HERO HEADER BLOG -->
    <header class="blog-hero">
      <div class="category-eyebrow">
        <span class="live-dot"></span> PUSAT EDUKASI &amp; WAWASAN DIGITAL
      </div>
      <h1>Blog &amp; Panduan Pemasaran Digital Bali</h1>
      <p class="hero-desc">
        Wawasan praktis seputar pengembangan website performa tinggi, strategi ranking halaman 1 Google, dan rahasia iklan online tertarget untuk pertumbuhan bisnis Anda di Bali.
      </p>
      
      <!-- Filter Kategori Cepat -->
      <div class="category-pills-row" id="blog-filters">
        <button type="button" class="filter-pill active" data-filter="all">Semua Topik</button>
        <button type="button" class="filter-pill" data-filter="website">Website</button>
        <button type="button" class="filter-pill" data-filter="ads">Iklan Ads</button>
        <button type="button" class="filter-pill" data-filter="seo-lokal">SEO Lokal</button>
      </div>
    </header>

    <!-- 2. GRID DAFTAR SEMUA ARTIKEL -->
    <section class="posts-grid-section">
      <div class="posts-grid" id="posts-container">
        {blogPosts.map((post) => (
          <article class="post-card" data-category={post.filterKey}>
            <a href={`/blog/${post.slug}/`} aria-label={`Baca ${post.title}`}>
              <div class="post-thumbnail">
                <img 
                  src={post.image || defaultImage} 
                  alt={post.title} 
                  loading="lazy" 
                  width="400" 
                  height="220" 
                />
                <span class="card-cat-badge">{post.category}</span>
              </div>
            </a>

            <div class="post-card-body">
              <div class="card-meta">
                <span>{post.publishDate}</span>
                <span class="meta-dot">•</span>
                <span>{post.readTime}</span>
              </div>

              <h2 class="post-card-title">
                <a href={`/blog/${post.slug}/`}>{post.title}</a>
              </h2>

              <p class="post-card-excerpt">{post.excerpt}</p>
            </div>

            <div class="post-card-footer">
              <a href={`/blog/${post.slug}/`} class="link-read-more">
                Baca Artikel Lengkap &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 3. BANNER KONSULTASI DIGITAL -->
    <section class="blog-cta-banner">
      <div class="cta-inner">
        <h2>Butuh Bantuan Membangun Website atau Menjalankan Iklan?</h2>
        <p>
          Diskusikan rencana digital bisnis Anda bersama tim <strong>Bali Nusa Media</strong>. Kami siap membantu dari perancangan web sampai iklan menghasilkan order WhatsApp.
        </p>
        <a 
          href="https://wa.me/6285168981959?text=Halo%20Bali%20Nusa%20Media,%20saya%20ingin%20konsultasi%20layanan%20digital%20setelah%20membaca%20blog" 
          class="btn-cta-wa"
          target="_blank" 
          rel="noopener noreferrer"
        >
          Konsultasi Gratis via WhatsApp
        </a>
      </div>
    </section>

  </main>
</MainLayout>

<style>
  /* Layout Root */
  .blog-index-container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
    font-family: inherit;
    color: #1e293b;
  }

  /* 1. Hero Header */
  .blog-hero {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 3rem;
  }

  .category-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0284c7;
    background: #e0f2fe;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.2rem;
    text-transform: uppercase;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    background-color: #0284c7;
    border-radius: 50%;
  }

  .blog-hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
    margin-bottom: 1.15rem;
    letter-spacing: -0.02em;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: #64748b;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .category-pills-row {
    display: flex;
    justify-content: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .filter-pill {
    font-size: 0.825rem;
    font-weight: 600;
    color: #475569;
    background: #f1f5f9;
    padding: 0.45rem 1.1rem;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1px solid #e2e8f0;
    font-family: inherit;
  }

  .filter-pill:hover,
  .filter-pill.active {
    background: #0284c7;
    color: #ffffff;
    border-color: #0284c7;
  }

  /* 2. Posts Grid */
  .posts-grid-section {
    margin-bottom: 4.5rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .post-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 26px -6px rgba(0, 0, 0, 0.08);
  }

  .post-thumbnail {
    position: relative;
    width: 100%;
    height: 210px;
    background: #0f172a;
    overflow: hidden;
  }

  .post-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .post-card:hover .post-thumbnail img {
    transform: scale(1.04);
  }

  .card-cat-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(4px);
    color: #38bdf8;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .post-card-body {
    padding: 1.5rem;
    flex-grow: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.775rem;
    color: #64748b;
    margin-bottom: 0.65rem;
  }

  .meta-dot {
    color: #cbd5e1;
  }

  .post-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.65rem;
  }

  .post-card-title a {
    color: #0f172a;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-card-title a:hover {
    color: #0284c7;
  }

  .post-card-excerpt {
    font-size: 0.875rem;
    color: #475569;
    line-height: 1.55;
    margin: 0;
  }

  .post-card-footer {
    padding: 1.1rem 1.5rem;
    border-top: 1px solid #f1f5f9;
  }

  .link-read-more {
    font-size: 0.85rem;
    font-weight: 700;
    color: #0284c7;
    text-decoration: none;
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .link-read-more:hover {
    text-decoration: underline;
    transform: translateX(3px);
  }

  /* 3. Banner CTA */
  .blog-cta-banner {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-radius: 20px;
    padding: 3.5rem 2rem;
    color: #ffffff;
    text-align: center;
  }

  .cta-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .cta-inner h2 {
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    font-weight: 800;
    margin-bottom: 0.85rem;
    line-height: 1.3;
  }

  .cta-inner p {
    font-size: 1.05rem;
    color: #cbd5e1;
    margin-bottom: 2rem;
    line-height: 1.55;
  }

  .btn-cta-wa {
    background: #0284c7;
    color: #ffffff !important;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.95rem 2rem;
    border-radius: 9999px;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .btn-cta-wa:hover {
    background: #0369a1;
    transform: translateY(-2px);
  }

  /* Responsive Rules */
  @media (max-width: 768px) {
    .blog-index-container {
      padding: 1.75rem 1rem 3.5rem;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Filter Kategori Client-Side Tanpa Reload
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const postCards = document.querySelectorAll<HTMLElement>('.post-card');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.dataset.filter || 'all';

      postCards.forEach((card) => {
        const category = card.dataset.category;
        if (filter === 'all' || category === filter) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
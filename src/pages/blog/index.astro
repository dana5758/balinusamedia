---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
    title="Blog Bali Nusa Media | Internet, CCTV & Website"
    description="Artikel dan informasi seputar Internet & WiFi, CCTV, Website, dan teknologi untuk rumah dan bisnis di Karangasem, Bali."
>

    <main class="hub-container service-page">

        <section class="service-hero">

            <div class="service-hero-text">

                <p class="eyebrow">
                    BLOG BALI NUSA MEDIA
                </p>

                <h1>
                    Informasi Teknologi
                    untuk Rumah & Bisnis
                </h1>

                <p>
                    Temukan artikel, panduan, dan informasi
                    seputar Internet & WiFi, CCTV, Website,
                    serta teknologi yang dapat membantu
                    kebutuhan bisnis Anda.
                </p>

            </div>


            <div class="service-hero-image">

                <img
                    src="/assets/img/hero.webp"
                    alt="Blog Bali Nusa Media"
                >

            </div>

        </section>


        <section class="service-section">

            <div class="section-title">

                <p class="eyebrow">
                    ARTIKEL TERBARU
                </p>

                <h2>
                    Informasi & Panduan Teknologi
                </h2>

            </div>


            <div class="blog-grid">

                <article class="blog-card">

                    <a
                        href="/blog/cara-mengatasi-wifi-lambat/"
                        class="blog-card-image"
                    >
                        <img
                            src="/assets/img/blog/wifi-lambat.webp"
                            alt="Cara mengatasi WiFi lambat"
                            loading="lazy"
                        >
                    </a>

                    <div class="blog-card-content">

                        <span class="blog-category">
                            Internet & WiFi
                        </span>

                        <h3>
                            <a
                                href="/blog/cara-mengatasi-wifi-lambat/"
                            >
                                Cara Mengatasi WiFi Lambat
                            </a>
                        </h3>

                        <p>
                            Beberapa hal yang perlu diperiksa
                            ketika koneksi WiFi terasa lambat
                            di rumah atau tempat usaha.
                        </p>

                        <a
                            href="/blog/cara-mengatasi-wifi-lambat/"
                            class="btn-card"
                        >
                            Baca Artikel
                        </a>

                    </div>

                </article>


                <article class="blog-card">

                    <a
                        href="/blog/tips-memilih-cctv/"
                        class="blog-card-image"
                    >
                        <img
                            src="/assets/img/blog/memilih-cctv.webp"
                            alt="Tips memilih CCTV"
                            loading="lazy"
                        >
                    </a>

                    <div class="blog-card-content">

                        <span class="blog-category">
                            CCTV
                        </span>

                        <h3>
                            <a
                                href="/blog/tips-memilih-cctv/"
                            >
                                Tips Memilih CCTV
                            </a>
                        </h3>

                        <p>
                            Hal-hal penting yang perlu dipertimbangkan
                            sebelum memasang CCTV untuk rumah
                            atau tempat usaha.
                        </p>

                        <a
                            href="/blog/tips-memilih-cctv/"
                            class="btn-card"
                        >
                            Baca Artikel
                        </a>

                    </div>

                </article>


                <article class="blog-card">

                    <a
                        href="/blog/website-untuk-umkm/"
                        class="blog-card-image"
                    >
                        <img
                            src="/assets/img/blog/website-umkm.webp"
                            alt="Website untuk UMKM"
                            loading="lazy"
                        >
                    </a>

                    <div class="blog-card-content">

                        <span class="blog-category">
                            Website
                        </span>

                        <h3>
                            <a
                                href="/blog/website-untuk-umkm/"
                            >
                                Mengapa UMKM Membutuhkan Website?
                            </a>
                        </h3>

                        <p>
                            Peran website sebagai identitas
                            digital dan sarana informasi
                            bagi bisnis.
                        </p>

                        <a
                            href="/blog/website-untuk-umkm/"
                            class="btn-card"
                        >
                            Baca Artikel
                        </a>

                    </div>

                </article>

            </div>

        </section>


        <section class="cta-section">

            <h2>
                Butuh Solusi Teknologi?
            </h2>

            <p>
                Jelajahi layanan Internet & WiFi, CCTV,
                dan Website dari Bali Nusa Media.
            </p>

            <a
                href="/"
                class="btn-cta"
            >
                Lihat Layanan
            </a>

        </section>

    </main>

</MainLayout>
---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
    title="Bali Nusa Media Karangasem | Internet, CCTV & Website"
    description="Bali Nusa Media melayani kebutuhan Internet & WiFi, CCTV, dan pembuatan website untuk rumah, UMKM, villa, kantor, dan bisnis di Karangasem, Bali."
>

    <main class="hub-container service-page">

        <section class="service-hero">

            <div class="service-hero-text">

                <p class="eyebrow">
                    BALI NUSA MEDIA
                </p>

                <h1>
                    Partner Teknologi untuk
                    Karangasem, Bali
                </h1>

                <p>
                    Bali Nusa Media membantu masyarakat,
                    UMKM, pemilik villa, kantor, toko,
                    restoran, dan berbagai usaha di
                    Karangasem mendapatkan solusi teknologi
                    yang sesuai dengan kebutuhan.
                </p>

                <a
                    href="https://wa.me/6285168981959"
                    class="btn-cta"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Konsultasi Sekarang
                </a>

            </div>


            <div class="service-hero-image">

                <img
                    src="/assets/img/hero.webp"
                    alt="Bali Nusa Media melayani kebutuhan teknologi di Karangasem"
                >

            </div>

        </section>


        <section class="service-section">

            <div class="section-title">

                <p class="eyebrow">
                    LAYANAN
                </p>

                <h2>
                    Solusi Teknologi untuk Karangasem
                </h2>

            </div>


            <div class="service-grid-3">

                <article class="service-info-card">

                    <h3>
                        Internet & WiFi
                    </h3>

                    <p>
                        Solusi jaringan Internet dan WiFi
                        untuk rumah, villa, kantor,
                        restoran, toko, dan berbagai usaha.
                    </p>

                    <a
                        href="/internet/"
                        class="btn-card"
                    >
                        Lihat Layanan
                    </a>

                </article>


                <article class="service-info-card">

                    <h3>
                        CCTV
                    </h3>

                    <p>
                        Pemasangan dan konfigurasi CCTV
                        untuk rumah, toko, kantor, villa,
                        dan tempat usaha.
                    </p>

                    <a
                        href="/cctv/"
                        class="btn-card"
                    >
                        Lihat Layanan
                    </a>

                </article>


                <article class="service-info-card">

                    <h3>
                        Website
                    </h3>

                    <p>
                        Pembuatan website profesional
                        untuk bisnis, UMKM, villa,
                        perusahaan, dan usaha lainnya.
                    </p>

                    <a
                        href="/website/"
                        class="btn-card"
                    >
                        Lihat Layanan
                    </a>

                </article>

            </div>

        </section>


        <section class="service-section service-section-soft">

            <div class="section-title">

                <p class="eyebrow">
                    AREA LAYANAN
                </p>

                <h2>
                    Melayani Wilayah Karangasem
                </h2>

                <p>
                    Jangkauan layanan dapat disesuaikan
                    dengan kebutuhan dan kondisi lokasi.
                </p>

            </div>


            <div class="service-grid-2">

                <article class="service-info-card">
                    <h3>Amlapura</h3>
                    <p>
                        Layanan teknologi untuk rumah,
                        bisnis, kantor, dan usaha.
                    </p>
                </article>

                <article class="service-info-card">
                    <h3>Abang</h3>
                    <p>
                        Solusi Internet, CCTV,
                        dan website sesuai kebutuhan.
                    </p>
                </article>

                <article class="service-info-card">
                    <h3>Bebandem</h3>
                    <p>
                        Dukungan teknologi untuk
                        masyarakat dan pelaku usaha.
                    </p>
                </article>

                <article class="service-info-card">
                    <h3>Rendang</h3>
                    <p>
                        Solusi jaringan dan digital
                        untuk berbagai kebutuhan.
                    </p>
                </article>

                <article class="service-info-card">
                    <h3>Selat</h3>
                    <p>
                        Layanan teknologi untuk rumah
                        dan usaha di wilayah Selat.
                    </p>
                </article>

                <article class="service-info-card">
                    <h3>Sidemen</h3>
                    <p>
                        Internet, CCTV, dan website
                        untuk berbagai kebutuhan bisnis.
                    </p>
                </article>

            </div>

        </section>


        <section class="service-section">

            <div class="section-title">

                <p class="eyebrow">
                    BALI NUSA MEDIA
                </p>

                <h2>
                    Mengapa Memilih Bali Nusa Media?
                </h2>

            </div>


            <div class="service-grid-3">

                <article class="service-info-card">

                    <h3>
                        Satu Vendor
                    </h3>

                    <p>
                        Kebutuhan Internet, CCTV,
                        dan Website dapat ditangani
                        melalui satu vendor.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Fokus pada Kebutuhan
                    </h3>

                    <p>
                        Solusi disesuaikan dengan kondisi
                        dan kebutuhan masing-masing pelanggan.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Berbasis Karangasem
                    </h3>

                    <p>
                        Fokus membangun layanan teknologi
                        untuk masyarakat dan bisnis di
                        Karangasem.
                    </p>

                </article>

            </div>

        </section>


        <section class="cta-section">

            <h2>
                Butuh Solusi Teknologi di Karangasem?
            </h2>

            <p>
                Hubungi Bali Nusa Media untuk
                mendiskusikan kebutuhan Anda.
            </p>

            <a
                href="https://wa.me/6285168981959"
                class="btn-cta"
                target="_blank"
                rel="noopener noreferrer"
            >
                Konsultasi via WhatsApp
            </a>

        </section>

    </main>

</MainLayout>
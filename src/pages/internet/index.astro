---
import MainLayout from "../../layouts/MainLayout.astro";
import allProducts from "../../data/products.json";

// Filter khusus produk berkategori Jaringan
const networkProducts = allProducts.filter(item => item.kategori === "Jaringan");
---

<MainLayout
    title="Jasa Pasang WiFi & Internet di Karangasem | Bali Nusa Media"
    description="Jasa pemasangan WiFi dan solusi jaringan internet untuk rumah, villa, kantor, restoran, toko, dan bisnis di Karangasem, Bali."
>

    <main class="hub-container service-page">

        <section class="service-hero">

            <div class="service-hero-text">

                <p class="eyebrow">
                    INTERNET & WIFI
                </p>

                <h1>
                    Jasa Pasang WiFi & Solusi Jaringan
                    untuk Rumah dan Bisnis
                </h1>

                <p>
                    Bali Nusa Media membantu menyediakan solusi
                    jaringan Internet & WiFi yang stabil, rapi,
                    dan disesuaikan dengan kebutuhan rumah,
                    villa, kantor, restoran, toko, dan usaha
                    di Karangasem.
                </p>

                <a
                    href="https://wa.me/6285168981959"
                    class="btn-cta"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Konsultasi WiFi
                </a>

            </div>

            <div class="service-hero-image">

                <img
                    src="/assets/img/wifi/hero-jaringan-wifi.webp"
                    alt="Jasa pemasangan WiFi dan jaringan internet di Karangasem"
                >

            </div>

        </section>


        <section class="service-section">

            <div class="section-title">

                <p class="eyebrow">
                    MASALAH YANG SERING TERJADI
                </p>

                <h2>
                    WiFi Lambat Tidak Selalu Berarti Internet Anda Buruk
                </h2>

            </div>


            <div class="service-grid-3">

                <article class="service-info-card">
                    <h3>Jangkauan Tidak Merata</h3>

                    <p>
                        Area tertentu sulit mendapatkan sinyal
                        WiFi yang kuat karena posisi router,
                        struktur bangunan, atau luas area.
                    </p>
                </article>


                <article class="service-info-card">
                    <h3>Banyak Pengguna</h3>

                    <p>
                        Banyak perangkat yang terhubung secara
                        bersamaan dapat membuat koneksi terasa
                        lambat dan tidak stabil.
                    </p>
                </article>


                <article class="service-info-card">
                    <h3>Jaringan Tidak Terencana</h3>

                    <p>
                        Instalasi jaringan yang tidak dirancang
                        dengan baik dapat menimbulkan masalah
                        koneksi dan performa.
                    </p>
                </article>

            </div>

        </section>

        <section class="service-section">

            <div class="section-title">
                <p class="eyebrow">
                    DAFTAR PAKET
                </p>
                <h2>
                    Pilihan Paket Jaringan & WiFi Terbaik
                </h2>
                <p>
                    Pilih paket perangkat jaringan yang sesuai dengan skala kebutuhan properti Anda.
                </p>
            </div>

            <div class="custom-product-grid">
                {networkProducts.map((item) => (
                    <div class="custom-product-card">
                        <div>
                            <div class="custom-product-img-wrap">
                                <img src={item.gambar} alt={item.nama_paket} loading="lazy" />
                            </div>
                            <span class="custom-badge">{item.kategori}</span>
                            <h3 class="custom-product-title">{item.nama_paket}</h3>
                            <p class="custom-product-desc">{item.deskripsi}</p>
                            <p class="custom-product-spec">Spesifikasi: {item.spesifikasi}</p>
                        </div>

                        <div class="custom-product-footer">
                            <div class="custom-price-wrap">
                                <span class="custom-price">{item.harga}</span>
                                {item.harga_coret && <span class="custom-price-old">{item.harga_coret}</span>}
                            </div>
                            
                            <a 
                                href={`https://wa.me/${item.whatsapp}?text=Halo,%20saya%20tertarik%20dengan%20${encodeURIComponent(item.nama_paket)}`} 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="custom-btn-whatsapp"
                            >
                                Pesan via WhatsApp
                            </a>
                        </div>
                    </div>
                ))}
            </div>

        </section>


        <section class="service-section">

            <div class="section-title">

                <p class="eyebrow">
                    PROSES KERJA
                </p>

                <h2>
                    Dari Konsultasi Sampai Instalasi
                </h2>

            </div>


            <div class="service-process">

                <div>
                    <span>01</span>
                    <h3>Konsultasi</h3>
                    <p>
                        Memahami kebutuhan dan kondisi lokasi.
                    </p>
                </div>

                <div>
                    <span>02</span>
                    <h3>Survey</h3>
                    <p>
                        Menentukan kebutuhan perangkat dan
                        rancangan jaringan.
                    </p>
                </div>

                <div>
                    <span>03</span>
                    <h3>Instalasi</h3>
                    <p>
                        Pemasangan dan konfigurasi jaringan.
                    </p>
                </div>

                <div>
                    <span>04</span>
                    <h3>Pengujian</h3>
                    <p>
                        Memastikan jaringan berjalan sesuai
                        kebutuhan yang telah disepakati.
                    </p>
                </div>

            </div>

        </section>


        <section class="cta-section">

            <h2>
                Butuh WiFi untuk Rumah atau Bisnis?
            </h2>

            <p>
                Konsultasikan kebutuhan jaringan Anda
                dengan Bali Nusa Media.
            </p>

            <a
                href="https://wa.me/6285168981959"
                class="btn-cta"
                target="_blank"
                rel="noopener noreferrer"
            >
                Konsultasi via WhatsApp
            </a>

        </section>

    </main>

</MainLayout>

<!-- CSS KARTU PRODUK (MENGGUNAKAN DESIGN SYSTEM GLOBAL) -->
<style>
  .custom-product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 28px;
    margin-top: 2rem;
  }

  .custom-product-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .custom-product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .custom-product-img-wrap {
    background: var(--sand);
    height: 190px;
    border-radius: calc(var(--radius) - 4px);
    overflow: hidden;
    margin-bottom: 16px;
  }

  .custom-product-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--sand);
    color: var(--blue);
    padding: 4px 10px;
    border-radius: 20px;
    margin-bottom: 10px;
  }

  .custom-product-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .custom-product-desc {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-bottom: 10px;
    line-height: 1.5;
  }

  .custom-product-spec {
    font-size: 0.82rem;
    color: #6b7280;
    font-style: italic;
    margin-bottom: 20px;
  }

  .custom-product-footer {
    border-top: 1px solid var(--line);
    padding-top: 16px;
    margin-top: auto;
  }

  .custom-price-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .custom-price {
    font-size: 1.25rem;
    font-weight: 800;
    color: #dc2626;
  }

  .custom-price-old {
    font-size: 0.85rem;
    color: #9ca3af;
    text-decoration: line-through;
  }

  .custom-btn-whatsapp {
    display: block;
    width: 100%;
    background-color: #16a34a;
    color: #ffffff;
    text-align: center;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .custom-btn-whatsapp:hover {
    background-color: #15803d;
  }
</style>
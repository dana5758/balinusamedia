---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
    title="Jasa Pasang WiFi & Internet di Karangasem | Bali Nusa Media"
    description="Jasa pemasangan WiFi dan solusi jaringan internet untuk rumah, villa, kantor, restoran, toko, dan bisnis di Karangasem, Bali."
>

    <main class="hub-container service-page">

        <section class="service-hero">

            <div class="service-hero-text">

                <p class="eyebrow">
                    INTERNET & WIFI
                </p>

                <h1>
                    Jasa Pasang WiFi & Solusi Jaringan
                    untuk Rumah dan Bisnis
                </h1>

                <p>
                    Bali Nusa Media membantu menyediakan solusi
                    jaringan Internet & WiFi yang stabil, rapi,
                    dan disesuaikan dengan kebutuhan rumah,
                    villa, kantor, restoran, toko, dan usaha
                    di Karangasem.
                </p>

                <a
                    href="https://wa.me/6285168981959"
                    class="btn-cta"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Konsultasi WiFi
                </a>

            </div>

            <div class="service-hero-image">

                <img
                    src="/assets/img/wifi/hero-jaringan-wifi.webp"
                    alt="Jasa pemasangan WiFi dan jaringan internet di Karangasem"
                >

            </div>

        </section>


        <section class="service-section">

            <div class="section-title">

                <p class="eyebrow">
                    MASALAH YANG SERING TERJADI
                </p>

                <h2>
                    WiFi Lambat Tidak Selalu Berarti Internet Anda Buruk
                </h2>

            </div>


            <div class="service-grid-3">

                <article class="service-info-card">
                    <h3>Jangkauan Tidak Merata</h3>

                    <p>
                        Area tertentu sulit mendapatkan sinyal
                        WiFi yang kuat karena posisi router,
                        struktur bangunan, atau luas area.
                    </p>
                </article>


                <article class="service-info-card">
                    <h3>Banyak Pengguna</h3>

                    <p>
                        Banyak perangkat yang terhubung secara
                        bersamaan dapat membuat koneksi terasa
                        lambat dan tidak stabil.
                    </p>
                </article>


                <article class="service-info-card">
                    <h3>Jaringan Tidak Terencana</h3>

                    <p>
                        Instalasi jaringan yang tidak dirancang
                        dengan baik dapat menimbulkan masalah
                        koneksi dan performa.
                    </p>
                </article>

            </div>

        </section>


        <section class="service-section service-section-soft">

            <div class="section-title">

                <p class="eyebrow">
                    LAYANAN KAMI
                </p>

                <h2>
                    Solusi Jaringan Sesuai Kebutuhan
                </h2>

            </div>


            <div class="service-grid-2">

                <article class="service-info-card">

                    <h3>
                        WiFi Rumah
                    </h3>

                    <p>
                        Penataan jaringan WiFi untuk rumah
                        agar jangkauan lebih sesuai dengan
                        kebutuhan penghuni.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        WiFi Bisnis
                    </h3>

                    <p>
                        Solusi jaringan untuk toko, restoran,
                        kantor, UMKM, dan tempat usaha.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        WiFi Villa & Penginapan
                    </h3>

                    <p>
                        Perencanaan jaringan untuk area
                        penginapan dengan kebutuhan akses
                        Internet di beberapa ruangan atau area.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Optimasi Jaringan
                    </h3>

                    <p>
                        Pemeriksaan dan penataan jaringan agar
                        perangkat dan koneksi dapat bekerja
                        lebih optimal.
                    </p>

                </article>

            </div>

        </section>


        <section class="service-section">

            <div class="section-title">

                <p class="eyebrow">
                    PROSES KERJA
                </p>

                <h2>
                    Dari Konsultasi Sampai Instalasi
                </h2>

            </div>


            <div class="service-process">

                <div>
                    <span>01</span>
                    <h3>Konsultasi</h3>
                    <p>
                        Memahami kebutuhan dan kondisi lokasi.
                    </p>
                </div>

                <div>
                    <span>02</span>
                    <h3>Survey</h3>
                    <p>
                        Menentukan kebutuhan perangkat dan
                        rancangan jaringan.
                    </p>
                </div>

                <div>
                    <span>03</span>
                    <h3>Instalasi</h3>
                    <p>
                        Pemasangan dan konfigurasi jaringan.
                    </p>
                </div>

                <div>
                    <span>04</span>
                    <h3>Pengujian</h3>
                    <p>
                        Memastikan jaringan berjalan sesuai
                        kebutuhan yang telah disepakati.
                    </p>
                </div>

            </div>

        </section>


        <section class="cta-section">

            <h2>
                Butuh WiFi untuk Rumah atau Bisnis?
            </h2>

            <p>
                Konsultasikan kebutuhan jaringan Anda
                dengan Bali Nusa Media.
            </p>

            <a
                href="https://wa.me/6285168981959"
                class="btn-cta"
                target="_blank"
                rel="noopener noreferrer"
            >
                Konsultasi via WhatsApp
            </a>

        </section>

    </main>

</MainLayout>
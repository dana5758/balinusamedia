---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
    title="Tentang Bali Nusa Media | Internet, CCTV & Website Karangasem"
    description="Kenal lebih dekat dengan Bali Nusa Media, penyedia layanan Internet & WiFi, CCTV, dan Website untuk masyarakat dan bisnis di Karangasem, Bali."
>

    <main class="hub-container service-page">

        <section class="service-hero">

            <div class="service-hero-text">

                <p class="eyebrow">
                    TENTANG KAMI
                </p>

                <h1>
                    Bali Nusa Media
                </h1>

                <p>
                    Bali Nusa Media merupakan vendor teknologi
                    yang berfokus pada Internet & WiFi, CCTV,
                    dan Website untuk kebutuhan rumah,
                    UMKM, villa, kantor, dan bisnis.
                </p>

                <a
                    href="/kontak/"
                    class="btn-cta"
                >
                    Hubungi Kami
                </a>

            </div>


            <div class="service-hero-image">

                <img
                    src="/assets/img/hero.webp"
                    alt="Bali Nusa Media"
                >

            </div>

        </section>


        <section class="service-section">

            <div class="section-title">

                <p class="eyebrow">
                    TENTANG BALI NUSA MEDIA
                </p>

                <h2>
                    Membangun Solusi Teknologi yang
                    Bisa Digunakan dalam Jangka Panjang
                </h2>

            </div>


            <div class="service-grid-2">

                <article class="service-info-card">

                    <h3>
                        Internet & WiFi
                    </h3>

                    <p>
                        Membantu kebutuhan konektivitas
                        rumah dan bisnis dengan perencanaan
                        jaringan yang sesuai kondisi lokasi.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        CCTV
                    </h3>

                    <p>
                        Membantu menyediakan sistem
                        pemantauan untuk rumah dan
                        berbagai jenis usaha.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Website
                    </h3>

                    <p>
                        Membantu bisnis memiliki website
                        sebagai identitas dan sarana
                        digital untuk menjangkau pelanggan.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Fokus pada Bisnis Lokal
                    </h3>

                    <p>
                        Kami membangun layanan dengan fokus
                        pada kebutuhan masyarakat dan pelaku
                        usaha di Karangasem.
                    </p>

                </article>

            </div>

        </section>


        <section class="service-section service-section-soft">

            <div class="section-title">

                <p class="eyebrow">
                    NILAI KAMI
                </p>

                <h2>
                    Prinsip dalam Melayani Pelanggan
                </h2>

            </div>


            <div class="service-grid-3">

                <article class="service-info-card">

                    <h3>
                        Jelas
                    </h3>

                    <p>
                        Menjelaskan kebutuhan, solusi,
                        dan proses pekerjaan dengan jelas.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Rapi
                    </h3>

                    <p>
                        Mengutamakan hasil instalasi,
                        struktur, dan tampilan yang rapi.
                    </p>

                </article>


                <article class="service-info-card">

                    <h3>
                        Berkelanjutan
                    </h3>

                    <p>
                        Website dan sistem jaringan
                        dirancang agar dapat dikembangkan
                        sesuai kebutuhan bisnis.
                    </p>

                </article>

            </div>

        </section>


        <section class="cta-section">

            <h2>
                Ingin Mengenal Bali Nusa Media Lebih Dekat?
            </h2>

            <p>
                Hubungi kami dan ceritakan kebutuhan teknologi
                untuk rumah atau bisnis Anda.
            </p>

            <a
                href="https://wa.me/6285168981959"
                class="btn-cta"
                target="_blank"
                rel="noopener noreferrer"
            >
                Konsultasi via WhatsApp
            </a>

        </section>

    </main>

</MainLayout>
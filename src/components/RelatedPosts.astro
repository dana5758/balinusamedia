---
interface Props {
  posts: {
    title: string;
    description: string;
    image: string;
    url: string;
    category?: string;
  }[];
}

const { posts } = Astro.props;
---

<section class="related-posts">

  <div class="section-title">

    <h2>
      Artikel Terkait
    </h2>

  </div>

  <div class="blog-grid">

    {posts.map((post) => (
      <article class="blog-card">

        <a href={post.url}>
          <img
            src={post.image}
            alt={post.title}
            loading="lazy"
          />
        </a>

        <div class="blog-card-content">

          {post.category && (
            <span class="blog-category">
              {post.category}
            </span>
          )}

          <h3>
            <a href={post.url}>
              {post.title}
            </a>
          </h3>

          <p>
            {post.description}
          </p>

        </div>

      </article>
    ))}

  </div>

</section>
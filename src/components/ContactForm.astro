<form
  class="contact-form"
  action={`https://wa.me/6285168981959`}
  target="_blank"
>

  <div class="form-group">

    <label for="name">
      Nama
    </label>

    <input
      id="name"
      name="name"
      type="text"
      placeholder="Nama Anda"
      required
    />

  </div>


  <div class="form-group">

    <label for="message">
      Kebutuhan
    </label>

    <textarea
      id="message"
      name="message"
      rows="5"
      placeholder="Ceritakan kebutuhan Anda..."
      required
    ></textarea>

  </div>


  <button
    type="submit"
    class="btn-cta"
  >
    Konsultasi
  </button>

</form>
---
interface Props {
  items: {
    name: string;
    url?: string;
  }[];
}

const { items } = Astro.props;
---

<nav
  class="breadcrumb"
  aria-label="Breadcrumb"
>

  <a href="/">
    Beranda
  </a>

  {items.map((item) => (
    <>
      <span aria-hidden="true">/</span>

      {item.url ? (
        <a href={item.url}>
          {item.name}
        </a>
      ) : (
        <span>
          {item.name}
        </span>
      )}
    </>
  ))}

</nav>
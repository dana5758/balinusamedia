---
// src/components/Footer.astro
const whatsapp = "6285168981959";
const email = "balinusamedia@gmail.com";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container footer-grid">
    
    <!-- KOLOM 1: IDENTITAS BRAND -->
    <div class="footer-column footer-brand">
      <h3 class="footer-brand-title">Bali Nusa <span class="accent-text">Media</span></h3>
      <p class="brand-desc">
        Agensi digital partner pertumbuhan bisnis di Bali. Spesialis pembuatan website berkecepatan tinggi, optimasi SEO lokal Google, serta manajemen kampanye iklan Google Search Ads dan Meta Ads (Instagram & Facebook).
      </p>
      <div class="location-badge">
        <span class="location-icon">📍</span> Karangasem, Bali — Melayani Seluruh Bali
      </div>

      <!-- Sinergi Sister Brand Lapangan -->
      <p class="sister-brand-note">
        Divisi instalasi CCTV, WiFi & Kelistrikan: <a href="https://balinusateknik.com" target="_blank" rel="noopener noreferrer">Bali Nusa Teknik</a>
      </p>
    </div>

    <!-- KOLOM 2: LAYANAN DIGITAL -->
    <div class="footer-column">
      <h4 class="footer-heading">Layanan Digital</h4>
      <ul class="footer-links">
        <li><a href="/#paket" class="nav-item">Paket Layanan</a></li>
        <li><a href="/google-ads/">Google Search Ads</a></li>
        <li><a href="/meta-ads/">Meta Ads (Instagram & FB)</a></li>
        <li><a href="/seo-lokal/">Optimasi SEO Lokal Bali</a></li>
      </ul>
    </div>

    <!-- KOLOM 3: PERUSAHAAN & INFORMASI -->
    <div class="footer-column">
      <h4 class="footer-heading">Perusahaan</h4>
      <ul class="footer-links">
        <li><a href="/tentang-kami/">Tentang Kami</a></li>
        <li><a href="/#portofolio">Portofolio Proyek</a></li>
        <li><a href="/blog/">Artikel &amp; Edukasi</a></li>
        <li><a href="/kontak/">Hubungi Kami</a></li>
      </ul>
    </div>

    <!-- KOLOM 4: HUBUNGI KAMI -->
    <div class="footer-column footer-contact">
      <h4 class="footer-heading">Alamat Operasional</h4>
      <address class="contact-address">
        Perum Grand Park Blok C No. 8, Subagan, Kec. Karangasem, Kab. Karangasem, Bali.
      </address>
      
      <div class="contact-links-wrap">
        <a 
          href={`https://wa.me/${whatsapp}?text=Halo%20Bali%20Nusa%20Media,%20saya%20ingin%20konsultasi%20layanan%20website%20dan%20iklan`} 
          class="contact-link"
          target="_blank" 
          rel="noopener noreferrer"
        >
          <span class="contact-icon">💬</span> +62 851-6898-1959
        </a>

        <a href={`mailto:${email}`} class="contact-link">
          <span class="contact-icon">✉️</span> {email}
        </a>

        <a href="/" class="contact-link">
          <span class="contact-icon">🌐</span> balinusamedia.com
        </a>
      </div>
    </div>

  </div>

  <!-- BAGIAN BAWAH / COPYRIGHT -->
  <div class="footer-bottom">
    <div class="footer-container footer-bottom-inner">
      <p class="copyright">
        &copy; {currentYear} PT. Bali Nusa Media. Hak Cipta Dilindungi.
      </p>

      <div class="footer-legal">
        <a href="/tentang-kami/">Tentang Kami</a>
        <span class="divider">•</span>
        <a href="/kontak/">Kontak</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #0b0f19;
    color: #94a3b8;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-family: inherit;
    font-size: 0.9rem;
    line-height: 1.6;
    padding-top: 4rem;
  }

  .footer-container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 2.5rem;
    padding-bottom: 3.5rem;
  }

  /* Kolom Brand */
  .footer-brand-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 0.85rem;
  }

  .footer-brand-title .accent-text {
    color: #38bdf8;
  }

  .brand-desc {
    color: #94a3b8;
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
    line-height: 1.55;
  }

  .location-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    margin-bottom: 0.85rem;
  }

  .sister-brand-note {
    font-size: 0.8rem;
    color: #64748b;
    margin: 0;
  }

  .sister-brand-note a {
    color: #cbd5e1;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .sister-brand-note a:hover {
    color: #38bdf8;
  }

  /* Kolom Navigasi */
  .footer-heading {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1.2rem;
    position: relative;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: #38bdf8;
    transform: translateX(3px);
  }

  /* Kolom Kontak */
  .contact-address {
    font-style: normal;
    font-size: 0.875rem;
    color: #cbd5e1;
    margin-bottom: 1.1rem;
    line-height: 1.5;
  }

  .contact-links-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #cbd5e1;
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  .contact-link:hover {
    color: #38bdf8;
  }

  .contact-icon {
    font-size: 0.95rem;
  }

  /* Footer Bottom */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background-color: #070a12;
    padding: 1.5rem 0;
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright {
    font-size: 0.8rem;
    color: #64748b;
    margin: 0;
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-legal a {
    font-size: 0.8rem;
    color: #64748b;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-legal a:hover {
    color: #38bdf8;
  }

  .divider {
    color: #334155;
    font-size: 0.75rem;
  }

  /* Responsif Tablet & Ponsel */
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .site-footer {
      padding-top: 3rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom-inner {
      flex-direction: column;
      text-align: center;
      justify-content: center;
    }
  }
</style>